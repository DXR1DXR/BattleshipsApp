<Page x:Class="BattleshipsApp.Pages.CreateGamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BattleshipsApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CreateGamePage" Background="White" Loaded="Page_Loaded" Unloaded="Page_Unloaded">

    <Grid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock FontSize="20">Поиск соперника...</TextBlock>
            <Button Name="CancelBT" Click="CancelBT_Click" Style="{DynamicResource MaterialDesignRaisedDarkButton}">Отмена</Button>
        </StackPanel>
    </Grid>
</Page>
