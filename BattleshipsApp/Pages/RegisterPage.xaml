<Page x:Class="BattleshipsApp.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BattleshipsApp.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
      Background="{DynamicResource MaterialDesign.Brush.Background}"
      TextElement.FontWeight="Medium"
      TextElement.FontSize="14"
      FontFamily="{materialDesign:MaterialDesignFont}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPage">

    <Grid>
        <Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" Padding="24" Background="#FFFFFF" CornerRadius="2" BorderBrush="#D1D5DB" BorderThickness="2">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Морской бой" FontSize="20" HorizontalAlignment="Center"/>
                <Separator Visibility="Hidden" Margin="3"/>
                <TextBlock Text="Регистрация" HorizontalAlignment="Center"/>

                <StackPanel>
                    <Label Content="Логин"/>
                    <TextBox x:Name="LoginTB"/>
                </StackPanel>

                <StackPanel>
                    <Label Content="Пароль"/>
                    <PasswordBox x:Name="PasswordPB"/>
                </StackPanel>

                <StackPanel>
                    <Label Content="Повтор пароля"/>
                    <PasswordBox x:Name="Password2PB"/>
                </StackPanel>

                <Separator Visibility="Hidden" Margin="4"/>

                <Button x:Name="EnterBT" Content="Зарегистрироваться" Click="EnterBT_Click"/>
                <Separator Visibility="Hidden" Margin="2"/>
                <Button Content="Есть аккаунт? Войти" Click="Authorize_Click" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>

</Page>
