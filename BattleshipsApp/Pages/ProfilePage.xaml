<Page x:Class="BattleshipsApp.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BattleshipsApp.Pages"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      TextBlock.FontFamily="pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto"
      TextBlock.FontSize="20"
      TextBlock.FontWeight="Bold"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage" Background="White">

    <Grid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock>Логин:</TextBlock>
                <TextBlock Text="{Binding Player.Login}"></TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock>Никнейм:</TextBlock>
                <TextBlock Text="{Binding Player.NickName}"></TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock>Кол-во побед:</TextBlock>
                <TextBlock Text="{Binding Player.WinCount}"></TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock>Кол-во поражений:</TextBlock>
                <TextBlock Text="{Binding Player.LoseCount}"></TextBlock>
            </StackPanel>
            <Separator Height="5" Background="Transparent"></Separator>
            <Button Name="UpdateBT" Click="UpdateBT_Click" Style="{DynamicResource MaterialDesignRaisedDarkButton}" >Обновить</Button>
            <Separator Height="5" Background="Transparent"></Separator>
            <Button Name="ChangeNameBT" Click="ChangeNameBT_Click" Style="{DynamicResource MaterialDesignRaisedDarkButton}" >Сменить имя</Button>
            <Separator Height="5" Background="Transparent"></Separator>
            <Button Name="ChangePasswordBT" Click="ChangePasswordBT_Click" Style="{DynamicResource MaterialDesignRaisedDarkButton}" >Сменить пароль</Button>
            <Separator Height="5" Background="Transparent"></Separator>
            <Button Name="ExitBT" Click="ExitBT_Click" Style="{DynamicResource MaterialDesignRaisedDarkButton}" >Выход</Button>
        </StackPanel>
    </Grid>
</Page>
