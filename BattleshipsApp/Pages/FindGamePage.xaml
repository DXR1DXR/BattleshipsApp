<Page x:Class="BattleshipsApp.Pages.FindGamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BattleshipsApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FindGamePage">
    <Grid>
        <ListView ItemsSource="{Binding Games}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"></StackPanel>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource MaterialDesignNavigationListBoxItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
                    <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#DDDDDD" CornerRadius="5" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Image Source="pack://application:,,,/Images/battleship.png" ></Image>
                            <StackPanel Grid.Column="1" Margin="10 0 0 0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#FEFEFE"
                                        CornerRadius="5"
                                        Padding="5">
                                        <TextBlock FontSize="20" Text="{Binding StringFormat=ИД игры: {0}, Path=Id}"></TextBlock>
                                    </Border>
                                    <Border Background="#FEFEFE"
                                            CornerRadius="5"
                                            Padding="5"
                                            Margin="10 0 0 0">
                                        <TextBlock FontSize="20" Text="{Binding StringFormat=Создано в: {0}, Path=DateString}"></TextBlock>
                                    </Border>
                                    
                                </StackPanel>
                                <Border Background="#FEFEFE"
                                        CornerRadius="5"
                                        Padding="5"
                                        Margin="0 10 0 0"
                                        HorizontalAlignment="Left">
                                    <TextBlock FontSize="30" Text="{Binding StringFormat=Создал: {0}, Path=CreatorNickname}"></TextBlock>
                                </Border>
                                
                            </StackPanel>
                        </Grid>
                        
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
